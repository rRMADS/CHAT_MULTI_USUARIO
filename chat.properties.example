server.bind=0.0.0.0
server.port=5050
server.maxClients=100
# Salas: identificador:nome, separadas por ponto e virgula. Mantenha o ID geral.
server.rooms=geral:Geral;estudos:Estudos;projetos:Projetos;cafe:Café;livre:Livre
db.url=jdbc:h2:./data/chat
db.user=sa
db.password=
history.limit=50
# IA opcional: a chave fica apenas na variavel GROQ_API_KEY do servidor.
# Veja docs/IA.md. Nao escreva a chave neste arquivo.
ai.enabled=false
ai.model=openai/gpt-oss-20b
